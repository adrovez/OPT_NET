## .gitignore centralizado del monorepo OPT
## Cubre: backend .NET (src/backend), frontend Angular (src/frontend),
## herramientas de IDE y ruido del sistema operativo.
## Referencias:
##   https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
##   https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# ─────────────────────────────────────────────
#  .NET — resultados de compilación
# ─────────────────────────────────────────────
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# NuGet
*.nupkg
*.snupkg

# MSBuild Binary and Structured Log
*.binlog

# Resultados de tests (MSTest / NUnit / cobertura)
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml
nunit-*.xml
CodeCoverage/
coverage/
*.coverage
*.coveragexml

# Publicación
publish/
*.pubxml.user
*.azurePubxml

# ─────────────────────────────────────────────
#  EF Core — la carpeta Migrations NO se versiona
#  (el esquema vive como scripts SQL en src/basedatos/)
# ─────────────────────────────────────────────
src/backend/OPT.Infrastructure/Migrations/

# ─────────────────────────────────────────────
#  Secretos / configuración local
#  (appsettings.json y appsettings.Development.json SÍ se versionan
#   porque tienen los campos sensibles vacíos por diseño)
# ─────────────────────────────────────────────
.env
secrets.json
appsettings.*.local.json

# ─────────────────────────────────────────────
#  Frontend Angular (src/frontend)
# ─────────────────────────────────────────────
node_modules/
/src/frontend/dist/
/src/frontend/tmp/
/src/frontend/out-tsc/
/src/frontend/bazel-out/
.angular/
npm-debug.log*
yarn-error.log*
.sass-cache/
connect.lock
libpeerconnection.log
testem.log
/src/frontend/typings/
__screenshots__/
/src/frontend/.nx/cache/
/src/frontend/.nx/workspace-data/

# ─────────────────────────────────────────────
#  IDE — Visual Studio
# ─────────────────────────────────────────────
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.DotSettings.user

# IDE — Rider / IntelliJ
.idea/
*.iml
.project
.classpath
.settings/

# IDE — VS Code (se permite compartir configuración base del equipo)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ─────────────────────────────────────────────
#  Sistema operativo
# ─────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─────────────────────────────────────────────
#  Varios
# ─────────────────────────────────────────────
~$*
*~
